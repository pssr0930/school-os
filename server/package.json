{
  "name": "school-os-server",
  "version": "1.0.0",
  "description": "Production-grade Express REST API server for School OS",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/server.js",
    "dev": "ts-node-dev --respawn --transpile-only --watch src src/server.ts",
    "dev:nodemon": "nodemon --watch src -e ts --exec ts-node src/server.ts"
  },
  "dependencies": {
    "@google/genai": "latest",
    "@supabase/supabase-js": "^2.45.0",
    "@types/ws": "^8.18.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.3.1",
    "jsonwebtoken": "^9.0.2",
    "twilio": "^5.1.0",
    "ws": "^8.21.2",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/node": "^20.14.9",
    "nodemon": "^3.1.4",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "5.9.3"
  }
}